# Шаблон /opt/vdalo/site.env і /opt/vdalo/site-staging.env.
# Власник вписує значення через: sudoedit /opt/vdalo/site.env
# Жодне значення тут НЕ має бути реальним.

# Основне
VDALO_SITE_URL=https://www.vdalo.tech
# Для staging-контейнера підстав: VDALO_SITE_URL=https://staging.vdalo.tech

# Приймання заявок
VDALO_LEAD_WEBHOOK_URL=
VDALO_TRIAL_WEBHOOK_URL=
VDALO_AUDIT_WEBHOOK_URL=
VDALO_WEBHOOK_BEARER_TOKEN=

# Воронка (окремий ендпоінт)
VDALO_FUNNEL_WEBHOOK_URL=
VDALO_FUNNEL_WEBHOOK_TOKEN=
VDALO_FUNNEL_LEGAL_NAME=
VDALO_FUNNEL_PRIVACY_EMAIL=
VDALO_FUNNEL_RETENTION=

# Email-звіти (Resend)
RESEND_API_KEY=
VDALO_REPORT_FROM=
VDALO_REPORT_PRIVACY_APPROVED=

# WayForPay (ПРОДАКШН-акаунт на тому самому домені — не змінюється в кабінеті)
WFP_MERCHANT_ACCOUNT=www_vdalo_tech
WFP_MERCHANT_DOMAIN=www.vdalo.tech
WFP_SECRET_KEY=

# SEO
SEO_LINK_PROPOSALS=
