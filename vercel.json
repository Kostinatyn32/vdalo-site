{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "qr-lab/public",
  "buildCommand": "npm --prefix qr-lab ci && npm --prefix qr-lab run build",
  "git": { "deploymentEnabled": true },
  "functions": { "api/index.mjs": { "includeFiles": "{versions/**/public/**,microlandings/public/**,microlandings/top5/**,qr-lab/dist/**}", "maxDuration": 30 } },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
